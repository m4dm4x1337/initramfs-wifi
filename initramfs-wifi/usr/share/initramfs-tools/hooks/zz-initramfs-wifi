# no pre requirement
PREREQ=""

prereqs()
{
    echo "${PREREQ}"
}

case "$1" in
    prereqs)
    prereqs
    exit 0
    ;;
esac

# import /usr/share/initramfs-tools/scripts/functions
. /usr/share/initramfs-tools/hook-functions

# http://www.marcfargas.com/posts/enable-wireless-debian-initramfs/
# https://github.com/cw-ansible/cw.wireless/blob/master/files/etc/initramfs-tools/hooks/wpa_supplicant
# https://www.cyberciti.biz/faq/linux-find-wireless-driver-chipset/
# https://askubuntu.com/questions/654820/how-to-find-pci-address-of-an-ethernet-interface
# https://gist.github.com/csghone/7c0c756a179cda0ae4afe1deb50d5a07

if [ -s /etc/initramfs-wifi/initramfs.conf ]; then
  . /etc/initramfs-wifi/initramfs.conf || true
fi

copy_exec /sbin/wpa_supplicant
copy_exec /sbin/wpa_cli
# copy_file config /etc/initramfs-wifi/wpa_supplicant.conf /etc/wpa_supplicant.conf # copy_file is missing in older releases
if [ "${verbose:-}" = "y" ]; then
  echo "Adding config /etc/initramfs-wifi/wpa_supplicant.conf"
fi
[ -d "${DESTDIR}/etc" ] || mkdir -p "${DESTDIR}/etc"
cp -pP /etc/initramfs-wifi/wpa_supplicant.conf "${DESTDIR}/etc/wpa_supplicant.conf"

copy_firmware_file() { # $1 = source path
  local source= target=

  if [ -z "$1" ] || [ ! -e "$1" ]; then
    return 1
  fi

  source="$1"
  target="${DESTDIR}$1"

  if [ -L "$source" ]; then
    source=$( readlink -f "$source" 2>/dev/null ) || return 1
    if [ -z "$source" ] || [ ! -e "$source" ]; then
      return 1
    fi
  fi

  if [ "${verbose:-}" = "y" ]; then
    echo "Adding firmware $1"
  fi

  [ -d "${target%/*}" ] || mkdir -p "${target%/*}"
  rm -f "$target"
  cp -p "$source" "$target"
}

copy_module_firmware() { # $1 = module name
  local pattern= path= suffix= filename= found=

  for pattern in $( modinfo -k "$version" -F firmware "$1" 2>/dev/null ); do
    found=
    for suffix in "" ".zst" ".xz"; do
      for path in \
        "/lib/firmware/updates/$version" \
        "/lib/firmware/updates" \
        "/lib/firmware/$version" \
        "/lib/firmware"; do
        for filename in "$path"/$pattern"$suffix"; do
          if [ -e "$filename" ]; then
            copy_firmware_file "$filename"
            found=1
          fi
        done
      done
    done
    if [ -z "$found" ] && [ "${verbose:-}" = "y" ]; then
      echo "[WARNING] missing firmware $pattern for module $1" >&2
    fi
  done
}

is_wireless_staging_module() { # $1 = module file path
  local module=

  if [ -z "$1" ] || [ ! -f "$1" ]; then
    return 1
  fi

  module="${1##*/}"
  module="${module%%.ko*}"

  case "$module" in
    prism2_usb|r8187se|r8188eu|r8192e_pci|r8192ee|r8192u_usb|r8712u|r8822be|rtl8821ae|vt6655_stage|vt6656_stage|w35und|wlags49_h25_cs|wlags49_h2_cs)
      return 0
    ;;
  esac

  return 1
}

modules=

case "${WIRELESS:-all}" in
  all)
    # add all regular wireless kernel modules
    for filename in $( find /lib/modules/$version/kernel/drivers/net/wireless/ -type f -name '*.ko*' ); do
      module="${filename##*/}"
      module="${module%%.ko*}"
      modules="$modules $module"
    done
    if [ -n "$modules" ]; then
      for module in $modules; do
        copy_module_firmware "$module"
      done
    fi
    copy_modules_dir kernel/drivers/net/wireless

    # add selected staging wireless kernel modules
    modules=
    for filename in $( find /lib/modules/$version/kernel/drivers/staging/ -type f -name '*.ko*' 2>/dev/null ); do
      if ! is_wireless_staging_module "$filename"; then
        continue
      fi
      module="${filename##*/}"
      module="${module%%.ko*}"
      modules="$modules $module"
    done
    if [ -n "$modules" ]; then
      for module in $modules; do
        if manual_add_modules "$module"; then
          copy_module_firmware "$module"
        fi
      done
    fi
  ;;
  loaded)
    while read -r module other; do
      if ! filename=$( modinfo -k "$version" -F filename "$module" 2>/dev/null ); then
        continue
      fi
      case "$filename" in
        */kernel/drivers/net/wireless/*)
          modules="$modules ${module%.ko}"
        ;;
      esac
    done < /proc/modules
    if [ -n "$modules" ]; then
      for module in $modules; do
        if manual_add_modules "$module"; then
          copy_module_firmware "$module"
        fi
      done
    fi
  ;;
  list)
    if [ ! -f /etc/initramfs-wifi/modules.conf ]; then
      echo "[WARNING] the file '/etc/initramfs-wifi/modules.conf' does not exist" >&2
      exit 0
    fi
    while IFS= read -r kmod || [ -n "$kmod" ]; do
      kmod="${kmod%%#*}" # strip comment
      kmod="${kmod#"${kmod%%[![:space:]]*}"}" # ltrim
      kmod="${kmod%"${kmod##*[![:space:]]}"}" # rtrim
      if [ -z "$kmod" ] || ! filename=$( modinfo -k "$version" -F filename "$kmod" 2>/dev/null ); then
        continue
      fi
      case "$filename" in
        */kernel/drivers/net/wireless/*)
          modules="$modules ${kmod%.ko}"
        ;;
        *)
          echo "[WARNING] the file '$filename' is not a wireless module" >&2
        ;;
      esac
    done < /etc/initramfs-wifi/modules.conf
    if [ -n "$modules" ]; then
      for module in $modules; do
        if manual_add_modules "$module"; then
          copy_module_firmware "$module"
        fi
      done
    fi
  ;;
  none)
    : # 
  ;;
  *)
    echo "[WARNING] 'WIRELESS=$WIRELESS' in '/etc/initramfs-wifi/initramfs.conf' is invalid" >&2
  ;;
esac
